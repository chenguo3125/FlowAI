# FlowAI — local secrets and Firebase web config
#
# Copy this file to `.env.local` (gitignored) and fill in what you have.
#
#     cp .env.example .env.local

# --- Model (server-side only; never bundled) ---------------------------------
FLOWAI_API_KEY=
FLOWAI_BASE_URL=https://api.openai.com/v1
FLOWAI_CHAT_MODEL=gpt-4o-mini

# --- Firebase (client web config; not a secret, but keep it out of git) ------
# Console → Project settings → Your apps → SDK setup and configuration.
# Leave blank to stay on IndexedDB only. The canvas still survives a refresh.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
